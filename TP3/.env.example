# ---------------------------------------------------------------------------
# TechNest Store API - environment variables
# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
NODE_ENV=development

# MongoDB (local server or MongoDB Atlas connection string)
MONGODB_URI=your_mongodb_connection_string

# JWT authentication
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional OAuth 2.0 / OpenID Connect access-token verification.
# Leave these values commented out to accept local JWTs only.
# When set, protected endpoints also accept a JWT access token issued by the
# provider and verified against its JWKS endpoint.
# ---------------------------------------------------------------------------
# OAUTH_ISSUER=https://your-oauth-provider.example.com/
# OAUTH_AUDIENCE=your-api-audience
# OAUTH_JWKS_URI=https://your-oauth-provider.example.com/.well-known/jwks.json
